
;; accepted in Phase 9 (phase9/round_01/maker/01_scaled_graph_metrics.mpr): Non-graphic points d_G/k of connected graphs G with tau(G) < 2k <= 4n: odd-prime denominators k (5, 9, 11, 13) not carried by graph metrics x_G on the same node set.
(generative scaled-graph-metrics (n) :domain (3 7)
  :doc "Non-graphic points d_G/k of connected graphs G with tau(G) < 2k <= 4n: odd-prime denominators k (5, 9, 11, 13) not carried by graph metrics x_G on the same node set."
  (for ((G (graphs n :connected)) (k (range 2 (+ (* 2 n) 1))))
    (where (< (triameter G) (* 2 k)))
    (scale (/ 1 k) (gmetric G))))

;; accepted in Phase 9 (phase9/round_03/maker/01_radial_of_normalized.mpr): Radial extension of the ray normalization: rescale x to its perimeter facet (2x/tau(x), C10) and apply Lambda^1 (C5); reaches points whose restriction is a multiple of a reached point.
(define (tau3 x) (max-over ((T (subsets (size x) 3))) (perimeter x T)))
(move radial-normalized (x) :grow 1
  :doc "Radial extension of the ray normalization: rescale x to its perimeter facet (2x/tau(x), C10) and apply Lambda^1 (C5); reaches points whose restriction is a multiple of a reached point."
  (if (> (tau3 x) 0) (list (radial-ext 1 (scale (/ 2 (tau3 x)) x))) (list)))
