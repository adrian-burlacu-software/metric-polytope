;;; phase8.mpr — the denominator lemma (Phase 8a), recorded as-is. Proof: docs/denominator_lemma.md.

(structural denominator-prime-bound (n) :domain (3 8)
  :source "docs/denominator_lemma.md, Theorem 4 (this work; proof sketch, computer checks separate)"
  :doc "If x is derivable from the uniform base by lift, radial 1–3, gluing, twin, dup and symmetries (detours allowed), every odd prime power exactly dividing den(x) is at most 2n − 3."
  (forall ((x (vertices n)))
    (implies (derivable? x #t) (den-bound-ok? (denominator x) n))))
