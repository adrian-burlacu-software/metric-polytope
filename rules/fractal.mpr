;;; fractal.mpr — the three versions of the block / fractal hypothesis (Phase 5), as ledger rules.
;;; Specification: `decompose` in rules/blocks.mpr. `decomposes-fast` is the tested-equal level-2 engine.

(structural fractal-const (n) :domain (3) :source "Phase 5 (this work)"
  :doc "Every vertex splits into top-left / bottom-right blocks and a middle, recursively all the way down, with every middle (and every middle's middle) constant up to sign flips."
  (forall ((x (vertices n))) (decomposes-fast x 0 #f)))

(structural fractal-structured (n) :domain (3) :source "Phase 5 (this work)"
  :doc "As fractal-const, but every middle may be constant, twin-like, or two-valued up to complement."
  (forall ((x (vertices n))) (decomposes-fast x 2 #f)))

(structural fractal-vertex-blocks (n) :domain (3) :source "Phase 5 (this work)"
  :doc "Strong form: a recursive decomposition exists in which every block is itself a vertex of its own metric polytope (any middle allowed)."
  (forall ((x (vertices n))) (decomposes-fast x 3 #t)))
