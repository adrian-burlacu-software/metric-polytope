;;; Round 12 maker, proposal 01: dyadic (D = 8) lift tower over a fixed 6-node core.
;;; Core w1 = (1/8) d_W on 6 nodes, W = weight-2 triangle {0,1,2} and weight-2 path 4-3-5, weight-3 edges 0-3, 0-5, 1-3,
;;; 2-4, 2-5 (here given in its canonical frame; w1 is NOT a vertex of m_6). Level k = orbits of the fiber vertices
;;; of the one-node lift of level k-1 with denominator exactly 8; output = level n-6 points that are exact vertices of m_n.
;;; At n = 8 (double lift) this contains 41 of the 49 unreached D = 8 targets (peel analysis, w6.py: each of them is a
;;; vertex of the fiber over a 7-node restriction y which is itself a vertex of the fiber over w1).
;;; Open-ended (the tower continues at every n), but levels >= 8 grow fast: n = 9 may not finish in the allowance.

(define dy8-w1 (lit 6 8 (2 2 3 3 3 2 3 3 5 5 5 3 6 2 4)))
(define (dy8-up L)
  (orbits (concat-all (for ((y L)) (for ((z (fiber-vertices (lift-partial y)))) (where (= (denominator z) 8)) z)))))
(define (dy8-level w k) (if (= k 0) (list w) (dy8-up (dy8-level w (- k 1)))))

(generative gen-dyadic-tower-w1 (n) :domain (6)
  :doc "Vertices among the (n-6)-fold D = 8 lift tower over the dyadic 6-node core (1/8) d_W (K_3 + P_3 at weight 2, 5 cross edges at weight 3)."
  (for ((z (dy8-level dy8-w1 (- n 6)))) (where (vertex? z)) z))
