;; Round 16 maker track B, proposal 01: twin-dup-fifths (bring in the prime 5 or 7 by a move).
;; New column b = (1 - t) twin_i + t Q_j with Q_j in {dup_j, antidup_j}, all nodes i, j (i = j allowed), t in T:
;;   twin_i    : b_k = x_ik (k != i), b_i = 0
;;   dup_j     : b_k = x_jk (k != j), b_j = delta_j,  delta_j = min_{k != j} min(2 x_jk, 2 - 2 x_jk)
;;   antidup_j : 1 - dup_j
;; Same segment as the accepted twin-dup-blend / twin-dup-third, at fifths/sevenths instead of quarters/thirds.
(define (tf-delta x j)
  (min-over ((k (range 0 (size x)))) (where (not (= k j)))
    (min (* 2 (entry x j k)) (- 2 (* 2 (entry x j k))))))
(define (tf-tw x i k) (if (= k i) 0 (entry x i k)))
(define (tf-dp x j d k) (if (= k j) d (entry x j k)))
(move twin-dup-fifths (x) :grow 1
  :doc "Point at t in TLIST of the segment from the twin column of node i to the dup or antidup column of node j: fiber-edge points of the partly reached D = 15 / 21 targets, bringing in the prime 5 or 7."
  (concat-all
    (for ((j (range 0 (size x))))
      (let ((d (tf-delta x j)))
        (for ((i (range 0 (size x))) (t (list TLIST)) (a (list 0 1)))
          (block x
                 (mvcat-list (for ((k (range 0 (size x))))
                               (+ (* (- 1 t) (tf-tw x i k))
                                  (* t (if (= a 0) (tf-dp x j d k) (- 1 (tf-dp x j d k)))))))
                 (const 1 0)))))))
