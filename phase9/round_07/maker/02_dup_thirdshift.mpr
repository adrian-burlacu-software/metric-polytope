;; Round 07 maker proposal 02: dup-thirdshift (group C, D = 12 at n = 8; D = 12, 15, 18 at n = 9).
;; Cheap subset of round 6's dup-recentre (dropped for budget at 30 n(n-1) columns per input): partial-dup column of
;; node i at t * delta_i with t in {1/4, 3/4, 1} (delta_i = min_j min(2 x_ij, 2 - 2 x_ij)), then ONE other entry j moved
;; to 1/3 or 2/3 of its feasible interval [L_j, U_j]:
;;   L_j = max_{k != j} |b_k - x_jk|,   U_j = min_{k != j} min(b_k + x_jk, 2 - b_k - x_jk).
;; sim3.py (round-6 cascade, current reached state, glue ignored): 15 targets (n = 8: 3, all D = 12; n = 9: 12,
;; D = 12: 8, 15: 2, 18: 2) that dup-midshift (t = 1, midpoint) does not reach. Only the new column is built, so x stays
;; the restriction on its first nodes. G-equivariant (delta_i, L_j, U_j are switching-invariant). 6 n (n - 1) columns.
(define (dt-delta x i)
  (min-over ((j (range 0 (size x)))) (where (not (= j i)))
    (min (* 2 (entry x i j)) (- 2 (* 2 (entry x i j))))))
(define (dt-b x i a k) (if (= k i) a (entry x i k)))
(define (dt-lo x i a j)
  (max-over ((k (range 0 (size x)))) (where (not (= k j)))
    (max (- (dt-b x i a k) (entry x j k)) (- (entry x j k) (dt-b x i a k)))))
(define (dt-hi x i a j)
  (min-over ((k (range 0 (size x)))) (where (not (= k j)))
    (min (+ (dt-b x i a k) (entry x j k)) (- 2 (+ (dt-b x i a k) (entry x j k))))))
(move dup-thirdshift (x) :grow 1
  :doc "Partial-dup column of node i (t = 1/4, 3/4, 1 of the largest feasible copy distance) with one other entry j moved to 1/3 or 2/3 of its feasible triangle interval: fiber-edge points off the twin--dup edge."
  (for ((i (range 0 (size x))) (t (list 1/4 3/4 1)) (j (range 0 (size x))) (s (list 1/3 2/3)))
    (where (not (= j i)))
    (let ((a (* t (dt-delta x i))))
      (let ((lo (dt-lo x i a j)))
        (block x (mset (mset (col x i) i 0 a) j 0 (+ lo (* s (- (dt-hi x i a j) lo)))) (const 1 0))))))
