;; Round 04 maker proposal 02: trisection points of pairs of fiber vertices of the one-node lift.
;; Keeps x as the restriction to its first (size x) nodes (only the new column is built), so it is restriction-
;; preserving on every input, vertex or not. G-equivariant (lift-partial, fiber-vertices, affine combinations).
(define (ft-col a b n)
  (mvcat-list (for ((j (range 0 n))) (/ (+ (* 2 (entry a j n)) (entry b j n)) 3))))
(move fiber-thirds (x) :grow 1
  :doc "New node whose distance column is (2a+b)/3 for two vertices a, b of the lift fiber over x (one-third points of fiber edges are the second commonest unreached one-node extension)."
  (let ((V (fiber-vertices (lift-partial x))))
    (for ((i (range 0 (len V))) (j (range 0 (len V))))
      (where (not (= i j)))
      (block x (ft-col (nth V i) (nth V j) (size x)) (const 1 0)))))
