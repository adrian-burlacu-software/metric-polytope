;;; Round 11 maker, proposal 03: D = 2n - 5 sister of gen-bipartite-glue, cover type the house (C_5 + chord) at 4/11 + P_4 at 3/11.
;;; Stage 1 glues (4/(2n-5)) d(complement of P_{n-3}) (at an end v of the path; at n = 8 this is the house, v a roof-base node) with the first three nodes v - b1 - b2 of
;;; (3/(2n-5)) d(P_4) (v an end of P_4); stage 2 glues each stage-1 fiber vertex with the whole P_4 on (v, b1, b2).
;;; At n = 8 all 6 D = 11 targets with this cover have v at a roof-base node of the house (round 8 called it K_{2,3}; the degree sequence is the same) and at an end of P_4, and their 7-node
;;; restriction (far end of P_4 dropped) is a stage-1 fiber vertex (stage.py). Both stages keep only points with
;;; denominator exactly 2n - 5 (cheap pre-filter, keeps all targets at n = 8); only exact vertices kept.

(define (bp11-k2m n) (move-last (tuple 0) (scale (/ 4 (- (* 2 n) 5)) (gmetric (complement (path-graph (- n 3)))))))
(define (bp11-p4 n) (scale (/ 3 (- (* 2 n) 5)) (gmetric (path-graph 4))))

(generative gen-house-p4-d11 (n) :domain (7)
  :doc "Vertices of the two-stage one-node glue of (4/(2n-5)) d(co-P_{n-3}) (path end) and (3/(2n-5)) d(P_4) (end node)."
  (concat-all
    (for ((y (fiber-vertices (glue-partial (bp11-k2m n) (restrict {0 1 2} (bp11-p4 n)) 1))))
      (where (= (denominator y) (- (* 2 n) 5)))
      (for ((z (fiber-vertices (glue-partial y (bp11-p4 n) 3))))
        (where (and (= (denominator z) (- (* 2 n) 5)) (vertex? z)))
        z))))
